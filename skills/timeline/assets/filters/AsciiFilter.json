{
  "type": "AsciiFilter",
  "schema": {
    "size": {
      "type": "number",
      "min": 2,
      "max": 20,
      "default": 8,
      "step": 1
    },
    "color": {
      "type": "color",
      "default": "#ffffff"
    },
    "replaceColor": {
      "type": "boolean",
      "default": false
    }
  }
}
