{
  "type": "GodrayFilter",
  "schema": {
    "time": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0,
      "step": 0.01
    },
    "gain": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "step": 0.01
    },
    "lacunarity": {
      "type": "number",
      "min": 0,
      "max": 5,
      "default": 2.75,
      "step": 0.01
    },
    "alpha": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 1,
