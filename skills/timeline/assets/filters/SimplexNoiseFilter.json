{
  "type": "SimplexNoiseFilter",
  "schema": {
    "strength": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "step": 0.01
    },
    "noiseScale": {
      "type": "number",
      "min": 0,
      "max": 50,
      "default": 10,
      "step": 0.1
    },
    "offsetX": {
      "type": "number",
      "min": 0,
      "max": 5,
      "default": 0,
      "step": 0.01
    },
    "offsetY": {
      "type": "number",
      "min": 0,
      "max": 5,
      "default": 0,
      "step": 0.01
    },
    "offsetZ": {
      "type": "number",
      "min": 0,
      "max": 5,
      "default": 0,
      "step": 0.01
    },
    "step": {
      "type": "number",
      "min": -1,
      "max": 1,
      "default": -1,
      "step": 0.01
    }
  }
}
