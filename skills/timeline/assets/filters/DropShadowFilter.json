{
  "type": "DropShadowFilter",
  "schema": {
    "blur": {
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 2,
      "step": 0.1
    },
    "quality": {
      "type": "number",
      "min": 1,
      "max": 20,
      "default": 3,
      "step": 1
    },
    "alpha": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "step": 0.01
    },
    "offset": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": 4,
          "step": 1
        },
        "y": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": 4,
          "step": 1
        }
      }
    },
    "color": {
      "type": "color",
      "default": "#000000"
    },
    "shadowOnly": {
      "type": "boolean",
      "default": false
    }
  }
}
