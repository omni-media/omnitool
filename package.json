{
	"name": "@omnimedia/omnitool",
	"version": "1.1.0-140",
	"description": "open source video processing tools",
	"license": "MIT",
	"author": "Przemysław Gałęzki",
	"type": "module",
	"main": "x/index.js",
	"exports": {
		".": {
			"types": "./x/index.d.ts",
			"default": "./x/index.js"
		},
		"./*": "./*"
	},
	"files": [
		"x",
		"s",
		"skills"
	],
	"scripts": {
		"build": "run-s _clean _tsc _ln _scute _catalog",
		"start": "octo 'scute -vw' 'tsc -w' 'node --watch x/tests.test.js' 'http-server x'",
		"_clean": "rm -rf x && mkdir x",
		"_tsc": "tsc",
		"_ln": "run-s _ln-s _ln-assets",
		"_ln-s": "ln -s \"$(realpath s)\" x/s",
		"_ln-assets": "ln -s \"$(realpath assets)\" x/assets",
		"_scute": "scute -v",
		"_catalog": "node scripts/catalog.js",
		"test": "echo \"node tests disabled for now\"",
		"test-debug": "node inspect x/tests.test.js"
	},
	"devDependencies": {
		"@e280/science": "^0.1.4",
		"@e280/scute": "^0.1.2",
		"@types/node": "^26.6.5",
		"@types/wicg-file-system-access": "^2023.10.7",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@awasm/noble": "^0.1.4",
		"@e280/comrade": "^0.1.0",
		"@e280/renraku": "^0.5.3",
		"@e280/stz": "^0.4.10",
		"@huggingface/transformers": "^4.3.1",
		"@noble/hashes": "~2.2.0",
		"gl-transitions": "^1.74.0",
		"lit": "^3.3.2",
		"mediabunny": "^1.61.1",
		"pixi-filters": "^6.1.5",
		"pixi.js": "^8.18.1"
	},
	"homepage": "https://github.com/omni-media/omnitool#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omni-media/omnitool.git"
	},
	"bugs": {
		"url": "https://github.com/omni-media/omnitool/issues"
	},
	"keywords": [
		"tools",
		"video",
		"processing"
	]
}
