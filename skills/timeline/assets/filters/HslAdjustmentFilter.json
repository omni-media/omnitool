{
  "type": "HslAdjustmentFilter",
  "schema": {
    "hue": {
      "type": "number",
      "min": -180,
      "max": 180,
      "default": 0,
      "step": 1
    },
    "saturation": {
      "type": "number",
      "min": -1,
      "max": 1,
      "default": 0,
      "step": 0.01
    },
    "lightness": {
      "type": "number",
      "min": -1,
      "max": 1,
      "default": 0,
      "step": 0.01
    },
    "colorize": {
      "type": "boolean",
      "default": false
    },
    "alpha": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 1,
      "step": 0.01
    }
  }
}
