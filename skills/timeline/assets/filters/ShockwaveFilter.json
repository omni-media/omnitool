{
  "type": "ShockwaveFilter",
  "schema": {
    "speed": {
      "type": "number",
      "min": 500,
      "max": 2000,
      "default": 500,
      "step": 1
    },
    "amplitude": {
      "type": "number",
      "min": 1,
      "max": 100,
      "default": 30,
      "step": 1
    },
    "wavelength": {
      "type": "number",
      "min": 2,
      "max": 400,
      "default": 160,
      "step": 1
    },
    "brightness": {
      "type": "number",
      "min": 0.2,
      "max": 2,
      "default": 1,
      "step": 0.01
    },
    "radius": {
      "type": "number",
      "min": 100,
      "max": 2000,
      "default": -1,
      "step": 1
    },
    "center": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "min": 0,
          "max": 1912,
          "default": 956,
          "step": 1
        },
        "y": {
          "type": "number",
          "min": 0,
          "max": 920,
          "default": 460,
          "step": 1
        }
      }
    }
  }
}
