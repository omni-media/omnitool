{
  "type": "CRTFilter",
  "schema": {
    "curvature": {
      "type": "number",
      "min": 0,
      "max": 10,
      "default": 1,
      "step": 0.01
    },
    "lineWidth": {
      "type": "number",
      "min": 0,
      "max": 5,
      "default": 3,
      "step": 0.01
    },
    "lineContrast": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "step": 0.01
    },
    "verticalLine": {
      "type": "boolean",
      "default": false
    },
    "noise": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.2,
      "step": 0.01
    },
    "noiseSize": {
      "type": "number",
      "min": 1,
      "max": 10,
      "default": 1,
      "step": 0.1
    },
    "vignetting": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "step": 0.01
    },
    "vignettingAlpha": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 1,
      "step": 0.01
    },
    "vignettingBlur": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.3,
      "step": 0.01
    },
    "seed": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0,
      "step": 0.01
    },
    "time": {
      "type": "number",
      "min": 0.5,
      "max": 20,
      "default": 0.5,
      "step": 0.01
    }
  }
}
