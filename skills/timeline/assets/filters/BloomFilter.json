{
  "type": "BloomFilter",
  "schema": {
    "strength": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "min": 0,
          "max": 20,
          "default": 2,
          "step": 0.1
        },
        "y": {
          "type": "number",
          "min": 0,
          "max": 20,
          "default": 2,
          "step": 0.1
        }
      }
    },
    "quality": {
      "type": "number",
      "min": 1,
      "max": 20,
      "default": 4,
      "step": 1
    },
    "resolution": {
      "type": "number",
      "min": 0.25,
      "max": 4,
      "default": 1,
      "step": 0.01
    },
    "kernelSize": {
      "type": "choice",
      "options": [
        5,
        7,
        9,
        11,
        13,
        15
      ],
      "default": 5
    }
  }
}
