{
  "type": "ReflectionFilter",
  "schema": {
    "mirror": {
      "type": "boolean",
      "default": true
    },
    "boundary": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "step": 0.01
    },
    "amplitude": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "min": 0,
          "max": 50,
          "default": 0,
          "step": 0.1
        },
        "end": {
          "type": "number",
          "min": 0,
          "max": 50,
          "default": 20,
          "step": 0.1
        }
      }
    },
    "waveLength": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "min": 10,
          "max": 200,
          "default": 30,
          "step": 1
        },
        "end": {
          "type": "number",
          "min": 10,
          "max": 200,
          "default": 100,
          "step": 1
        }
      }
    },
    "alpha": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 1,
          "step": 0.01
        },
        "end": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 1,
          "step": 0.01
        }
      }
    },
    "time": {
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 0,
      "step": 0.01
    }
  }
}
