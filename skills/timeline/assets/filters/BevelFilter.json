{
  "type": "BevelFilter",
  "schema": {
    "rotation": {
      "type": "number",
      "min": 0,
      "max": 360,
      "default": 45,
      "step": 1
    },
    "thickness": {
      "type": "number",
      "min": 0,
      "max": 10,
      "default": 2,
      "step": 0.1
    },
    "lightColor": {
      "type": "color",
      "default": "#ffffff"
    },
    "lightAlpha": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "step": 0.01
    },
    "shadowColor": {
      "type": "color",
      "default": "#000000"
    },
    "shadowAlpha": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "step": 0.01
    }
  }
}
