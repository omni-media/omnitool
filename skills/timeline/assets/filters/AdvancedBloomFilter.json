{
  "type": "AdvancedBloomFilter",
  "schema": {
    "threshold": {
      "type": "number",
      "min": 0.1,
      "max": 0.9,
      "default": 0.5,
      "step": 0.01
    },
    "bloomScale": {
      "type": "number",
      "min": 0.5,
      "max": 1.5,
      "default": 1,
      "step": 0.01
    },
    "brightness": {
      "type": "number",
      "min": 0.5,
      "max": 1.5,
      "default": 1,
      "step": 0.01
    },
    "blur": {
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 8,
      "step": 0.1
    },
    "quality": {
      "type": "number",
      "min": 1,
      "max": 20,
      "default": 4,
      "step": 1
    }
  }
}
