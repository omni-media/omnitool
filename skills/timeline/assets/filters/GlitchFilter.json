{
  "type": "GlitchFilter",
  "schema": {
    "slices": {
      "type": "number",
      "min": 0,
      "max": 64,
      "default": 5,
      "step": 1
    },
    "seed": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "step": 0.01
    },
    "offset": {
      "type": "number",
      "min": -400,
      "max": 400,
      "default": 100,
      "step": 1
    },
    "direction": {
      "type": "number",
      "min": -180,
      "max": 180,
      "default": 0,
      "step": 1
    },
    "fillMode": {
      "type": "choice",
      "options": {
        "TRANSPARENT": 0,
        "ORIGINAL": 1,
        "LOOP": 2,
        "CLAMP": 3,
        "MIRROR": 4
      },
      "default": "LOOP"
    },
    "average": {
      "type": "boolean",
      "default": false
    },
    "minSize": {
      "type": "number",
      "min": 0,
      "max": 64,
      "default": 8,
      "step": 1
    },
    "sampleSize": {
      "type": "number",
      "min": 1,
      "max": 2048,
      "default": 512,
      "step": 1
    },
    "red": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": 2,
          "step": 1
        },
        "y": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": 2,
          "step": 1
        }
      }
    },
    "blue": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": 10,
          "step": 1
        },
        "y": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": -4,
          "step": 1
        }
      }
    },
    "green": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": -10,
          "step": 1
        },
        "y": {
          "type": "number",
          "min": -50,
          "max": 50,
          "default": 4,
          "step": 1
        }
      }
    }
  }
}
