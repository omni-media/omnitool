{
  "type": "KawaseBlurFilter",
  "schema": {
    "strength": {
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 4,
      "step": 0.1
    },
    "quality": {
      "type": "number",
      "min": 1,
      "max": 20,
      "default": 3,
      "step": 1
    },
    "pixelSize": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "min": 0,
          "max": 10,
          "default": 1,
          "step": 0.1
        },
        "y": {
          "type": "number",
          "min": 0,
          "max": 10,
          "default": 1,
          "step": 0.1
        }
      }
    }
  }
}
